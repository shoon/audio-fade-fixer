      VALUE "OriginalFilename", "audio-fade-fixer.exe\0"
      VALUE "ProductName", "Audio Fade Fixer\0"
      VALUE "ProductVersion", "0.1.1\0"
    END
  END
  BLOCK "VarFileInfo"
